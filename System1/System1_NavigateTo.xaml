  <Sequence sap2010:Annotation.AnnotationText="Navigates the attached ACME System 1 tab to in_URL.&#xA;A redirect to the login page means the session is gone: System Exception, so the framework retries and re-initializes the application.&#xA;Each page workflow then verifies its own page loaded." DisplayName="System1 Navigate To" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="CurrentURL" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log Message (Navigate)" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Navigating to &quot; + in_URL]" />
    <uix:NApplicationCard AttachMode="ByInstance" CloseMode="Never" DisplayName="Use Browser Chrome: ACME System 1 (attach)" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" InteractionMode="DebuggerApi" OpenMode="Never" ScopeGuid="95b36dab-52c3-49a5-8e5b-990a833dbdb1" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <uix:NGoToUrl DisplayName="Go To URL (in_URL)" sap2010:WorkflowViewState.IdRef="NGoToUrl_1" Url="[in_URL]" Version="V5" />
            <uix:NGetUrl CurrentUrl="[CurrentURL]" DisplayName="Get URL (current page)" sap2010:WorkflowViewState.IdRef="NGetUrl_1" Version="V5" />
          </Sequence>
        </ActivityAction>
      </uix:NApplicationCard.Body>
      <uix:NApplicationCard.OCREngine>
        <ActivityFunc x:TypeArguments="sd:Image, scg:IEnumerable(scg:KeyValuePair(sd1:Rectangle, x:String))">

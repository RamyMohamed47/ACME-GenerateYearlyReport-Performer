      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Regex.Match(If(VendorInformation, String.Empty), "TaxID:\s*(\S+)").Groups(1).Value.Trim]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[String.IsNullOrWhiteSpace(out_TaxID)]" DisplayName="If Tax ID not found" sap2010:WorkflowViewState.IdRef="If_1">
